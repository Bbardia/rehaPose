#!/bin/sh
# Everything (~35 s) on exactly the commits being pushed: fast checks, then the e2e scenarios.
set -e
cd "$(git rev-parse --show-toplevel)"
idx=$(mktemp -d); trap 'rm -rf "$idx"' EXIT
export GIT_INDEX_FILE="$idx/index"  # pre-commit then checks this snapshot
while read -r _ sha _ _; do
  [ "$sha" = 0000000000000000000000000000000000000000 ] && continue  # a branch delete
  git read-tree "$sha"
  REHAPOSE_E2E=1 githooks/pre-commit
done
