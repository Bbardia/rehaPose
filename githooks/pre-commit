#!/bin/sh
# Fast checks before every commit (~10 s): lint, maths self-check, headless UI smoke test.
set -e
cd "$(git rev-parse --show-toplevel)"
PY=.venv/bin/python; [ -x "$PY" ] || PY=python3
RUFF=.venv/bin/ruff; [ -x "$RUFF" ] || RUFF=ruff
export QT_QPA_PLATFORM=offscreen
"$RUFF" check .
"$PY" -B analysis.py
"$PY" -B test_rehapose.py
