#!/bin/sh
# Fast checks (~10 s): lint, maths self-check, UI smoke test - on commit, of exactly what is staged.
set -e
cd "$(git rev-parse --show-toplevel)"
PY=$PWD/.venv/bin/python; [ -x "$PY" ] || PY=python3
RUFF=$PWD/.venv/bin/ruff; [ -x "$RUFF" ] || RUFF=ruff
if [ -n "$GIT_INDEX_FILE" ]; then  # run by git: test the snapshot, not the working tree
  snap=$(mktemp -d); trap 'rm -rf "$snap"' EXIT
  git checkout-index -a --prefix="$snap/"
  cd "$snap"
fi
export QT_QPA_PLATFORM=offscreen
"$RUFF" check .
"$PY" -B analysis.py
"$PY" -B test_rehapose.py
[ -z "$REHAPOSE_E2E" ] || "$PY" -B test_e2e.py
